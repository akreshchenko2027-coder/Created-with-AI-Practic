# Скопіюйте цей файл у .env. Це налаштування локальної Ollama:
# Gemini API key та платний хмарний доступ не потрібні.
# Файл .env локальний і до репозиторію не додається.

# ---- Локальна мультимодальна модель через Ollama ----

# Спершу встановіть Ollama та виконайте: ollama pull gemma3:4b
LLM_BASE_URL=http://localhost:11434/v1/

# Ollama не перевіряє цей обовʼязковий параметр клієнтської бібліотеки.
LLM_API_KEY=ollama

LLM_MODEL=gemma3:4b

# Вилучення — не творча задача: температура нульова. Запас max_tokens —
# на всі поля й таблицю позицій: рахунок з одинадцятьма рядками дає
# помітно довший JSON, ніж відповідь помічника в ПР6.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2500

# Зображення обробляється довше, ніж текст.
LLM_TIMEOUT=60

# ---- Зображення (нове) ----

# Найбільший розмір файлу, який приймає застосунок, у мегабайтах.
UPLOAD_MAX_MB=10

# До якого розміру за довшою стороною зменшувати зображення перед
# надсиланням моделі. Менше — дешевше й швидше, але дрібні цифри
# зливаються. Значення — відправна точка, а не відповідь.
IMAGE_MAX_SIDE=1600
