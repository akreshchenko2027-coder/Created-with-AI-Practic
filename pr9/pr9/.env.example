# Скопіюйте цей файл у .env. Для віддаленого провайдера задайте свій ключ.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Мовна модель ----

# Адреса OpenAI-сумісного ендпоінта Ollama.
LLM_BASE_URL=http://localhost:11434/v1

# Ollama не потребує ключа; OpenAI-сумісний клієнт очікує непорожнє значення.
LLM_API_KEY=ollama

# Модель має підтримувати виклик інструментів і structured output.
LLM_MODEL=qwen3:4b

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800

# Скільки секунд чекати на одну відповідь моделі.
LLM_TIMEOUT=30

# ---- Агент із ПР8 ----

# Скільки разів за одне звернення агент може звернутися до моделі.
TOOL_MAX_ROUNDS=3

# ---- Workflow (нове) ----

# Обмеження одного звернення. Значення — відправна точка: свої
# обґрунтуйте тим, скільки кроків, секунд і токенів потрібно звичайному
# зверненню.
#
# Скільки кроків журналу може мати звернення.
WORKFLOW_MAX_STEPS=12
# Скільки секунд може тривати автоматична частина обробки. Час
# очікування оператора сюди не входить.
WORKFLOW_TIMEOUT=60
# Скільки токенів (запит + відповідь, сумарно за всі кроки) може
# витратити одне звернення.
WORKFLOW_TOKEN_BUDGET=8000

# Де зберігається стан звернень. Відносний шлях — від папки, з якої
# запущено застосунок (pr9). До репозиторію каталог не потрапляє.
RUNS_DIR=runs

# ---- Сервіс магазину ----

# Сьогоднішня дата сервісу: від неї рахуються строки повернення.
SHOP_TODAY=2026-10-06

# Імітація повільного й ненадійного сервісу: затримка кожного виклику в
# мілісекундах і частка викликів, що завершуються відмовою (від 0 до 1).
SHOP_DELAY_MS=0
SHOP_FAILURE_RATE=0
